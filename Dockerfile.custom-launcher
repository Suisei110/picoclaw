# Custom PicoClaw Launcher with Ollama Cloud Support
# Multi-stage build

# Stage 1: Build frontend
FROM node:20-slim AS frontend-builder

WORKDIR /src/web/frontend

# Install build deps
RUN apt-get update && apt-get install -y git

# Copy frontend source
COPY web/frontend/ ./

# Install dependencies and build frontend
RUN npm install --legacy-peer-deps && \
    npm run build:backend 2>&1 | tail -100

# Stage 2: Build backend
FROM golang:1.25-alpine AS backend-builder

WORKDIR /src

# Install build dependencies
RUN apk add --no-cache git make

# Copy Go source
COPY go.mod go.sum ./
COPY pkg/ ./pkg/
COPY cmd/ ./cmd/
COPY web/backend/ ./web/backend/
COPY --from=frontend-builder /src/web/backend/dist ./web/backend/dist

# Build launcher
ARG VERSION=dev
ARG GIT_COMMIT=unknown
ARG BUILD_TIME=unknown
ARG GO_VERSION=go1.25.8

RUN CGO_ENABLED=0 go build \
    -tags goolm,stdjson \
    -ldflags "-X github.com/sipeed/picoclaw/pkg/config.Version=${VERSION} \
              -X github.com/sipeed/picoclaw/pkg/config.GitCommit=${GIT_COMMIT} \
              -X github.com/sipeed/picoclaw/pkg/config.BuildTime=${BUILD_TIME} \
              -X github.com/sipeed/picoclaw/pkg/config.GoVersion=${GO_VERSION} \
              -s -w" \
    -o /usr/local/bin/picoclaw-launcher \
    ./web/backend/

# Also build the main picoclaw binary
RUN go build \
    -o /usr/local/bin/picoclaw \
    ./cmd/picoclaw

# Stage 3: Runtime
FROM alpine:3.21

RUN apk add --no-cache ca-certificates tzdata

# Copy binaries
COPY --from=backend-builder /usr/local/bin/picoclaw /usr/local/bin/picoclaw
COPY --from=backend-builder /usr/local/bin/picoclaw-launcher /usr/local/bin/picoclaw-launcher

# Create user
RUN addgroup -g 1000 picoclaw && \
    adduser -D -u 1000 -G picoclaw picoclaw

USER picoclaw

# Run onboard
RUN /usr/local/bin/picoclaw onboard

ENTRYPOINT ["picoclaw-launcher"]
CMD ["-public", "-no-browser"]
