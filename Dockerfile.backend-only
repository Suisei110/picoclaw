# Backend-only launcher with Ollama Cloud support
FROM golang:1.25-alpine AS builder

WORKDIR /src
RUN apk add --no-cache git make

COPY go.mod go.sum ./
COPY pkg/ ./pkg/
COPY cmd/ ./cmd/
COPY web/backend/ ./web/backend/

# Build launcher
RUN CGO_ENABLED=0 go build \
    -tags goolm,stdjson \
    -ldflags "-X github.com/sipeed/picoclaw/pkg/config.Version=custom-ollama \
              -X github.com/sipeed/picoclaw/pkg/config.GitCommit=306abfc \
              -s -w" \
    -o /usr/local/bin/picoclaw-launcher \
    ./web/backend/

FROM alpine:3.21
RUN apk add --no-cache ca-certificates tzdata
COPY --from=builder /usr/local/bin/picoclaw-launcher /usr/local/bin/
RUN addgroup -g 1000 picoclaw && adduser -D -u 1000 -G picoclaw picoclaw
USER picoclaw
ENTRYPOINT ["picoclaw-launcher"]
CMD ["-public", "-no-browser"]
