# Merged PicoClaw with Ollama Cloud support
FROM alpine:3.21

RUN apk add --no-cache ca-certificates tzdata

# Copy official launcher (with frontend)
COPY --from=sipeed/picoclaw:launcher /usr/local/bin/picoclaw-launcher /usr/local/bin/picoclaw-launcher

# Copy custom picoclaw (with Ollama Cloud)
COPY --from=picoclaw-main:latest /usr/local/bin/picoclaw /usr/local/bin/picoclaw

RUN chmod +x /usr/local/bin/picoclaw-launcher /usr/local/bin/picoclaw

ENTRYPOINT ["picoclaw-launcher"]
CMD ["-public", "-no-browser"]
