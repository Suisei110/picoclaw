# Launcher Dockerfile with Ollama Cloud support
FROM golang:1.25-alpine AS builder

WORKDIR /src
RUN apk add --no-cache git make nodejs npm

# Copy source
COPY . .

# Build frontend first
RUN cd web/frontend && npm install --legacy-peer-deps && npm run build:backend 2>&1 | tail -50

# Build backend
RUN cd web && CGO_ENABLED=0 go build -tags goolm,stdjson -ldflags "-s -w" -o /usr/local/bin/picoclaw-launcher ./backend/

FROM alpine:3.21
RUN apk add --no-cache ca-certificates tzdata
COPY --from=builder /usr/local/bin/picoclaw-launcher /usr/local/bin/
ENTRYPOINT ["picoclaw-launcher"]
CMD ["-public", "-no-browser"]
